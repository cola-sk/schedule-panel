        <mxCell id="11" value="创建或更新 Wiki Docx&#xa;保留 source URL / version / hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="9"><mxGeometry x="40" y="180" width="200" height="80" as="geometry" /></mxCell>
