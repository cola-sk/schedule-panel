<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.5">
  <diagram id="wiki-to-feishu-sync" name="文档归档流程">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="平台新入口&#xa;配置来源、模型与发布策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="3" value="Confluence 目录扫描&#xa;递归获取 pageId、标题、版本、层级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="4" value="正文提取与清洗&#xa;HTML → Markdown / 纯文本&#xa;附件仅记录链接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="5" value="去重与增量判定&#xa;sourcePageId + version/hash&#xa;跳过未变更文档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="6" value="自定义 OpenAI 兼容 LLM&#xa;分类 + 置信度 + 理由&#xa;固定 JSON Schema 输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="250" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="7" value="分类规则校验&#xa;7 个一级类 + 二级类白名单&#xa;低置信度 / 无法识别 → 待审核" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="930" y="250" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="8" value="人工审核队列&#xa;可改分类、排除、编辑标题&#xa;批量批准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="480" width="210" height="90" as="geometry" /></mxCell>
